# Generate with: uv run python -m app.gen_keypair
ORACLE_SECRET_KEY_HEX=

# Curation (propose/resolve events) requires this exact value in the
# X-Admin-Key header. Public GET endpoints (/events, /events/{id}/...)
# need nothing.
ADMIN_API_KEY=change-me

DATABASE_URL=sqlite+aiosqlite:///./data/oracle.db
SERVICE_BASE_URL=http://localhost:8420

# Backs POST /admin/events/{id}/auto-resolve for category: "btc-price"
# events (median BTC/USD across several exchanges - see
# app/services/price_source.py). Not yet a live deployment at this
# default. For local dev/testing against a real feed, run
# lnbits-price-aggregator yourself and point this at it, e.g.
# PRICE_SOURCE_URL=http://localhost:8000
PRICE_SOURCE_URL=https://price.lnurlcash.com

# app/services/scheduler.py - a background loop that announces a fresh
# "will BTC be above its own price right now" event every hour and every
# day, and auto-resolves any btc-price event once its maturityTime has
# passed. On by default - harmless until PRICE_SOURCE_URL above points at
# a real, reachable price feed (a failed fetch is just logged and retried
# next tick), set to false for a purely operator-curated deployment.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
